DATABASE_URL=postgres://user:pass@host/db
BETTER_AUTH_SECRET=replace-with-32-plus-char-random-string
# Must match the origin you open in the browser (Vite serves localhost:3000).
BETTER_AUTH_URL=http://localhost:3000
# Optional — `pnpm db:seed` creates this verified email/password login
# SEED_USER_EMAIL=dev@example.com
# SEED_USER_PASSWORD=change-me-please
