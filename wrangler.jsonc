{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-cf-starter",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat",
    "no_handle_cross_request_promise_resolution"
  ],
  "main": "./src/entry-server.ts",
  "observability": { "enabled": true },
  // Queues — replace queue names with your own. Producers + consumers are
  // wired so entry-server's queue() handler can dispatch by queue name.
  "queues": {
    "producers": [
      { "binding": "MAIL_QUEUE", "queue": "starter-mail-queue" },
      { "binding": "USAGE_QUEUE", "queue": "starter-usage-queue" }
    ],
    "consumers": [
      {
        "queue": "starter-mail-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "starter-mail-queue-dlq"
      },
      {
        "queue": "starter-usage-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "starter-usage-queue-dlq"
      }
    ]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://example.com"
  },
  "r2_buckets": [
    { "binding": "IMAGES_BUCKET", "bucket_name": "starter-images" }
  ],
  "browser": { "binding": "BROWSER", "remote": true },
  // Create with: pnpm wrangler kv namespace create CONFIG_KV
  // then paste the id here.
  "kv_namespaces": [
    { "binding": "CONFIG_KV", "id": "REPLACE_ME" }
  ],
  "ratelimits": [
    { "name": "AI_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }
  ]
  // Required secrets (set via `wrangler secret put NAME`):
  //   - DATABASE_URL: Neon Postgres connection string
  //   - BETTER_AUTH_SECRET: 32+ char random secret
}
